#!/usr/bin/env bash

set -Eeuo pipefail

#######################################
# Print error message and exit
#######################################
die() {
    local msg="${1:-Unknown error}"
    local code="${2:-1}"

    [[ "${_PRINT_HELP:-no}" == "yes" ]] && print_help >&2

    echo "ERROR: $msg" >&2
    exit "$code"
}

#######################################
# Default arguments
#######################################
_arg_input=""
_arg_output=""

#######################################
# Help message
#######################################
print_help() {
    cat <<EOF
Usage:
    $0 -i <input.proto> -o <output_directory>

Options:
    -i, --input      Input .proto file
    -o, --output     Output directory
    -h, --help       Show this help message

Example:
    $0 -i ./example/test.proto -o ./generated
EOF
}

#######################################
# Parse CLI arguments
#######################################
parse_commandline() {

    while [[ $# -gt 0 ]]; do

        case "$1" in

            -i|--input)
                [[ $# -lt 2 ]] && die "Missing value for $1"
                _arg_input="$2"
                shift 2
                ;;

            --input=*)
                _arg_input="${1#*=}"
                shift
                ;;

            -o|--output)
                [[ $# -lt 2 ]] && die "Missing value for $1"
                _arg_output="$2"
                shift 2
                ;;

            --output=*)
                _arg_output="${1#*=}"
                shift
                ;;

            -h|--help)
                print_help
                exit 0
                ;;

            *)
                _PRINT_HELP=yes
                die "Unexpected argument: $1"
                ;;
        esac
    done
}

#######################################
# Detect OS
#######################################
detect_protoc() {

    local unameOut
    unameOut="$(uname -s)"

    case "$unameOut" in
        Linux*)
            PROTOC="$BASE_PATH/bin/linux-protoc"
            ;;
        Darwin*)
            PROTOC="$BASE_PATH/bin/osx-protoc"
            ;;
        *)
            PROTOC="protoc"
            ;;
    esac
}

#######################################
# Validate dependencies
#######################################
validate_environment() {

    command -v python >/dev/null 2>&1 \
        || die "Python is required but not installed."

    command -v dirname >/dev/null 2>&1 \
        || die "'dirname' command missing."

    [[ -f "$_arg_input" ]] \
        || die "Input file does not exist: $_arg_input"

    mkdir -p "$_arg_output" \
        || die "Failed to create output directory."
}

#######################################
# Resolve protobuf-solidity path
#######################################
resolve_base_path() {

    BASE_PATH=$(
        python - <<'PY'
import os
import importlib

module = importlib.import_module("protobuf-solidity")
print(os.path.dirname(os.path.abspath(module.__file__)))
PY
    ) || die "Failed to locate protobuf-solidity package."
}

#######################################
# Main generation function
#######################################
generate_solidity() {

    local parentdir
    parentdir="$(dirname "$_arg_input")"

    echo "Using protoc: $PROTOC"
    echo "Input file : $_arg_input"
    echo "Output dir : $_arg_output"

    "$PROTOC" \
        -I"$parentdir" \
        -I"$BASE_PATH/src/protoc/include" \
        --plugin="protoc-gen-sol=$BASE_PATH/src/protoc/plugin/gen_sol.py" \
        --sol_out="gen_runtime=ProtoBufRuntime.sol:$_arg_output" \
        "$_arg_input"

    echo "Generation completed successfully."
}

#######################################
# Main
#######################################
main() {

    parse_commandline "$@"

    [[ -z "$_arg_input" ]] && {
        _PRINT_HELP=yes
        die "Missing input file."
    }

    [[ -z "$_arg_output" ]] && {
        _PRINT_HELP=yes
        die "Missing output directory."
    }

    validate_environment

    resolve_base_path

    detect_protoc

    generate_solidity
}

main "$@"
